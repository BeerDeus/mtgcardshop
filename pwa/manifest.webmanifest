{
  "id": "./",
  "name": "Mana Orbit",
  "short_name": "Mana Orbit",
  "description": "Ta collection Magic, tes decks et les meilleurs prix : valeur de tes cartes, decks EDHREC à monter, panier CardTrader le moins cher.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0b0f1c",
  "theme_color": "#0b0f1c",
  "categories": ["shopping", "games", "utilities"],
  "prefer_related_applications": false,
  "share_target": { "action": "./", "method": "GET", "enctype": "application/x-www-form-urlencoded", "params": { "title": "title", "text": "text", "url": "url" } },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Scanner", "short_name": "Scanner", "description": "Ajouter des cartes à ta collection avec l'appareil photo", "url": "./?open=scan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Prix rapide", "short_name": "Prix rapide", "description": "Le prix d'une carte, sans l'ajouter à ta collection", "url": "./?open=quick", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Échange", "short_name": "Échange", "description": "Tes doublons à proposer et les cartes que tu recherches", "url": "./?open=trade", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Nouveau panier", "short_name": "Panier", "description": "Colle une decklist : le prix de chaque carte et le total", "url": "./?open=paste", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
