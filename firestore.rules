rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Autre appli du même projet Firebase : lecture par tout compte connecté ; modifier ou supprimer une partie, seulement son créateur
    // (la création de compte est ouverte à tous avec Mana Orbit), qui ne peut pas la céder à un autre compte (createdBy inchangé).
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }

    // Deck Deal : chacun ne lit et n'écrit que ses propres decks
    match /users/{uid}/decks/{deckId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'text', 'opts', 'cards', 'history', 'snap', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'text', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() <= 60000
        && request.resource.data.updatedAt is number
        && (!('history' in request.resource.data)
            || (request.resource.data.history is list && request.resource.data.history.size() <= 40))
        // Prix gardés carte par carte (deck viewer) : facultatif, borné
        && (!('snap' in request.resource.data)
            || (request.resource.data.snap is map
                && request.resource.data.snap.keys().hasOnly(['at', 'mode', 'lang', 'sig', 'items', 'pv', 'pa'])
                && request.resource.data.snap.items is list
                && request.resource.data.snap.items.size() <= 400));
    }

    // Deck Deal : partages publics (liste d'échange, deck) — lisibles par quiconque a le lien (identifiant aléatoire),
    // jamais listables, écrits et supprimés seulement par leur propriétaire. Le propriétaire est noté par l'empreinte SHA-256
    // de son UID (champ o) : le document est public, l'UID n'y apparaît pas.
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.o == ownerTag() && validShare();
      allow update: if request.auth != null && resource.data.o == ownerTag() && request.resource.data.o == ownerTag() && validShare();
      allow delete: if request.auth != null && resource.data.o == ownerTag();
      function ownerTag() { return hashing.sha256(request.auth.uid).toHexString().lower(); }
      function validShare() {
        return request.resource.data.keys().hasOnly(['o', 'kind', 'v', 'updatedAt', 'd'])
          && request.resource.data.keys().hasAll(['o', 'kind', 'updatedAt', 'd'])
          && request.resource.data.kind in ['trade', 'deck']
          && request.resource.data.updatedAt is number
          && request.resource.data.d is string && request.resource.data.d.size() <= 900000;
      }
    }

    // Deck Deal : données annexes du compte, un document chacune
    //  · collection : cartes possédées (liste « 3 Sol Ring » une carte par ligne)
    //  · engaged    : cartes réservées par des decks « montés » ({ decks: { idDeck: { n, at, q: { carte: exemplaires } } } })
    //  · history    : valeur de la collection dans le temps ({ pts: [{ t, v: centimes, n: cartes, q: exemplaires }, …] }, un par jour, 420 au plus ; pas de tableaux imbriqués dans Firestore)
    //  · trade      : liste d'échange ({ keep: réserve, kept: [cartes gardées], wish: { carte: { n, q } }, share: id du lien, dsh: { deck: id du lien } })
    //  · profile    : pseudo (30 caractères) et photo (data:image, ≤ 40 Ko), affichés sur les liens partagés
    match /users/{uid}/meta/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.updatedAt is number
        && (
          (docId == 'collection'
            && request.resource.data.keys().hasOnly(['text', 'count', 'updatedAt'])
            && request.resource.data.keys().hasAll(['text', 'updatedAt'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 900000
            && (!('count' in request.resource.data) || request.resource.data.count is number))
          || (docId == 'engaged'
            && request.resource.data.keys().hasOnly(['decks', 'updatedAt'])
            && request.resource.data.keys().hasAll(['decks', 'updatedAt'])
            && request.resource.data.decks is map
            && request.resource.data.decks.size() <= 80)
          || (docId == 'history'
            && request.resource.data.keys().hasOnly(['pts', 'updatedAt'])
            && request.resource.data.keys().hasAll(['pts', 'updatedAt'])
            && request.resource.data.pts is list
            && request.resource.data.pts.size() <= 420)
          || (docId == 'trade'
            && request.resource.data.keys().hasOnly(['keep', 'kept', 'wish', 'share', 'dsh', 'updatedAt'])
            && request.resource.data.keep is number
            && request.resource.data.kept is list && request.resource.data.kept.size() <= 5000
            && request.resource.data.wish is map && request.resource.data.wish.size() <= 2000
            && request.resource.data.share is string && request.resource.data.share.size() <= 40
            && request.resource.data.dsh is map && request.resource.data.dsh.size() <= 200)
          || (docId == 'profile'
            && request.resource.data.keys().hasOnly(['name', 'photo', 'updatedAt'])
            && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is number)
            && (!('name' in request.resource.data)
                || (request.resource.data.name is string && request.resource.data.name.size() <= 30))
            && (!('photo' in request.resource.data)
                || (request.resource.data.photo is string && request.resource.data.photo.size() <= 40000
                    && request.resource.data.photo.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))))
        );
    }

    // Classeur Full Art (autre appli du même projet Firebase, pas Mana Orbit) : un seul document par compte
    //   users/{uid}/binder/lands = { owned: { <scryfallId>: true }, pages: { <codeSet>: "12" }, updatedAt }
    // Gardé ici : publier ce fichier remplace TOUTES les règles du projet.
    match /users/{uid}/binder/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && docId == 'lands'
        && request.resource.data.keys().hasOnly(['owned', 'pages', 'updatedAt'])
        && request.resource.data.keys().hasAll(['owned', 'updatedAt'])
        && request.resource.data.owned is map
        && request.resource.data.owned.size() <= 5000
        && request.resource.data.updatedAt is number
        && (!('pages' in request.resource.data)
            || (request.resource.data.pages is map && request.resource.data.pages.size() <= 1500));
    }
  }
}
