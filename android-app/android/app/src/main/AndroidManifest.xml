<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup="false" : pas de sauvegarde Google Drive du stockage de la WebView (token CardTrader, jeton FCM) ni du widget -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Menu « Partager » d'une autre appli (EDHREC, Archidekt, Moxfield dans le navigateur, notes) : une decklist ou un lien, ouvert dans « Nouveau panier »
                 (ManaOrbitPlugin → événement « open » { view: 'share' } → onShared, comme le share_target de la PWA). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Raccourcis de l'icône (appui long) : Scanner, Prix rapide, Échange, Nouveau panier -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- Relais des raccourcis de l'icône (ShortcutActivity.java) : tâche à part (taskAffinity vide), pour que le FLAG_ACTIVITY_CLEAR_TASK qu'Android impose
             aux raccourcis statiques vide cette tâche-là et pas l'appli ouverte. Non exporté : le lanceur démarre un raccourci au nom de l'appli elle-même. -->
        <activity
            android:name=".ShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Widget d'écran d'accueil « Ma collection » (ValueWidget.java). Non exporté : seul le système (AppWidgetManager) lui envoie ses mises à jour. -->
        <receiver
            android:name=".ValueWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_value_info" />
        </receiver>

        <!-- Valeur du widget estimée appli fermée (ValueRefreshJob.java) : tâche JobScheduler toutes les ~12 h, réseau requis. Seul le système peut la lancer. -->
        <service
            android:name=".ValueRefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Scan : modèle de lecture du texte (ML Kit) téléchargé dès l'installation, pas au premier scan -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- Notifications (Firebase Cloud Messaging) : petite icône blanche et couleur d'accent ; sans elles, Android affiche un carré blanc. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_mana" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/mana_notif" />

        <!-- AdMob : identifiant d'application. Celui-ci est l'identifiant de TEST de Google ; remplace-le par le tien (console AdMob › Applis) avant la publication. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Widget : la tâche de fond exige du réseau (obligatoire pour une tâche JobScheduler avec réseau dès Android 14) et préfère le Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notifications (Android 13 et plus : demandée à l'utilisateur quand il active les notifications dans l'appli) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Scan des cartes : appareil photo natif (aperçu Camera1 du plugin camera-preview + reconnaissance du texte ML Kit, sur l'appareil) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
