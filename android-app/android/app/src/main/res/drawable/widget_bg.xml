<?xml version="1.0" encoding="utf-8"?>
<!-- Fond du widget : la nuit de l'appli (#232b5c au halo, #0b0f1c au bord, comme l'icône et l'orbe de l'accueil), coins arrondis, filet indigo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:centerX="0.3"
        android:centerY="0.2"
        android:endColor="#0B0F1C"
        android:gradientRadius="240dp"
        android:startColor="#232B5C"
        android:type="radial" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#33929CFF" />
</shape>
