<?xml version="1.0" encoding="utf-8"?>
<!-- Fond du widget « QR code d'échange » : blanc (un lecteur de QR code attend du foncé sur clair, thème sombre compris), coins arrondis comme le widget
     de valeur (widget_bg.xml), filet gris pour qu'il se détache d'un fond d'écran clair. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#2614182B" />
</shape>
