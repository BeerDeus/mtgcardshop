<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « QR code d'échange » (TradeWidget) : 2 × 2 par défaut, agrandissable (le QR code suit la taille). Pas de mise à jour périodique
     (updatePeriodMillis à 0) : le code ne change que quand le site l'envoie (setTradeWidget du plugin ManaOrbit : lien créé, arrêté, renouvelé, pseudo, langue).
     targetCell*, previewLayout et description : Android 12 et plus (ignorés avant, où minWidth/minHeight et previewImage servent). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_trade_description"
    android:initialLayout="@layout/widget_trade"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/widget_trade_preview"
    android:previewLayout="@layout/widget_trade_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
