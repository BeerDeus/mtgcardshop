<?xml version="1.0" encoding="utf-8"?>
<!-- Textes des widgets « Ma collection » et « QR code d'échange ». Ici l'anglais, langue par défaut ; français, allemand, espagnol, italien et portugais (du Brésil) dans values-fr/, -de/, -es/, -it/, -pt/
     (même règle que le site : téléphone dans une de ces langues → cette langue, toute autre → anglais). Avec des chiffres, ValueWidget prend la langue choisie dans l'appli. -->
<resources>
    <string name="widget_label">Collection value</string>
    <string name="widget_description">Your Magic collection value, its change and its curve, with a shortcut to the scanner</string>
    <string name="widget_title">My collection</string>
    <string name="widget_empty">Open Mana Orbit to show your collection</string>
    <!-- %1$s : « ▲ +€12 », « ▼ −€8 » ou « ± €0 » ; %2$d : durée de la variation en jours -->
    <string name="widget_delta">%1$s · %2$dd</string>
    <!-- chiffres de plus de 36 h (même texte que l'appli : « {n} d ago ») -->
    <string name="widget_age">%1$d d ago</string>
    <!-- valeur recalculée appli fermée d'après les prix du jour, jusqu'à la prochaine ouverture de l'appli -->
    <string name="widget_estimated">estimated</string>
    <string name="widget_btn_scan">Scan</string>
    <string name="widget_btn_quick">Quick price</string>
    <!-- légende de la courbe : sa durée en jours -->
    <string name="widget_chart_span">%1$dd</string>
    <string name="widget_chart_wait">The chart appears after two days of readings</string>
    <plurals name="widget_cards">
        <item quantity="one">%1$s card</item>
        <item quantity="other">%1$s cards</item>
    </plurals>
    <!-- lecteur d'écran : %1$s la valeur, %2$s le nombre de cartes -->
    <string name="widget_a11y">My collection: %1$s, %2$s</string>
    <!-- aperçu dans la liste des widgets (Android 12 et plus) -->
    <string name="widget_preview_value">€1,234</string>
    <string name="widget_preview_delta">▲ +€12 · 7d</string>
    <string name="widget_preview_count">312 cards</string>
    <string name="widget_preview_span">30d</string>

    <!-- Widget « QR code d'échange » (TradeWidget) : nom et description dans la liste des widgets -->
    <string name="widget_trade_label">Trade QR code</string>
    <string name="widget_trade_description">The QR code of your public trade list link, for others to scan straight from your home screen</string>
    <!-- sous le QR code (avec le pseudo), et seul en gras sans pseudo -->
    <string name="widget_trade_sub">Trade list</string>
    <!-- pas de lien d'échange (pas encore créé, arrêté, compte déconnecté) ; toucher ouvre l'onglet Échange -->
    <string name="widget_trade_none">Create your trade link</string>
    <string name="widget_trade_hint">Tap to open the Trade tab</string>
    <!-- rien reçu de l'appli (pas encore ouverte depuis l'installation) -->
    <string name="widget_trade_wait">Open Mana Orbit to show your trade QR code</string>
    <!-- lecteur d'écran : %1$s le pseudo -->
    <string name="widget_trade_a11y">QR code of %1$s\'s trade list</string>
    <string name="widget_trade_a11y_me">QR code of your trade list</string>
</resources>
